APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave SESSION_DOMAIN unset: the TressSessionDomain middleware shares
# the session cookie across tc/trade/ops/plus.dvaughnhouse.com only
# when the request host is under that parent (one sign-in covers all
# four surfaces, Nov 20 2026). An explicit SESSION_DOMAIN would apply
# to every host, including staging on dvaughnhouse.org, where the
# browser would reject the cookie and sessions would break.
SESSION_DOMAIN=null
# Parent domain for the shared Tress session cookie. See above.
SESSION_SHARED_DOMAIN=.dvaughnhouse.com

# Albert Pass sign-in (Tress Column). Values live only in the host
# environment; never commit a real secret. WORKOS_REDIRECT_URI must be
# the real callback route, <app-url>/auth/callback — the path the
# WorkOS dashboard wildcard https://*.dvaughnhouse.com/auth/callback
# matches (Nov 20, 2026 fix). /auth/workos/callback is only an alias.
WORKOS_CLIENT_ID=
WORKOS_CLIENT_SECRET=
WORKOS_REDIRECT_URI=
WORKOS_OWNER_EMAILS=dvaughn@dvaughnhouse.com

# WalletConnect (Reown Cloud) project ID for the Tress Column terminal.
# Create a project at cloud.reown.com and paste its project ID here.
# Empty = WalletConnect stays off; browser wallets still work.
VITE_WALLETCONNECT_PROJECT_ID=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Glenride attestation signing (protocol v2.0). The signing key is the
# base64 Ed25519 secret key; it lives ONLY in the issuing host's
# environment (mode 600), is never committed, copied, printed, or
# logged. Generate it on the host with sodium_crypto_sign_keypair and
# record ONLY the public key + fingerprint in config/attestation.php.
ATTESTATION_KEY_ID=glenride-ed25519-2026-11
ATTESTATION_SIGNING_KEY=
ATTESTATION_TIMESTAMP_ENABLED=true
ATTESTATION_TSA_URL=https://freetsa.org/tsr

# ContextForge LLM Configuration (fake, lmstudio, ollama, anthropic, openai)
CONTEXTFORGE_LLM_DRIVER=fake
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=default
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gdisney/mixtral-uncensored:latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
CONTEXTFORGE_LLM_TIMEOUT=120

# Stripe Configuration (The Economic Engine)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_KEY="${STRIPE_KEY}"
